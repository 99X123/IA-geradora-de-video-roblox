  "lines": [
    {
      "index": 0,
      "speaker": "N",
      "character_id": "narrator",
      "text": "Eu só queria um dia normal, até meu robô decidiu fazer café no modo turbo aparecer na minha sala.",
      "start": 0.1763,
      "end": 5.3036,
      "word_count": 19
    },
    {
      "index": 1,
      "speaker": "C",
      "character_id": "costar",
      "text": "Calma, Leo. Eu tenho um plano totalmente científico e sem chance de dar errado.",
      "start": 6.343,
      "end": 10.9376,
      "word_count": 14
    },
    {
      "index": 2,
      "speaker": "N",
      "character_id": "narrator",
      "text": "Quando fomos para a praça central, o assunto sobre meu robô decidiu fazer café no modo turbo já tinha virado o maior caos da cidade.",
      "start": 12.0243,
      "end": 18.7372,
      "word_count": 25
    },
    {
      "index": 3,
      "speaker": "N",
      "character_id": "narrator",
      "text": "Em vez de explodir, a praça inteira aplaudiu e me entregou um troféu de maior invenção do ano.",
      "start": 19.7723,
      "end": 24.6102,
      "word_count": 18
    },
    {
      "index": 4,
      "speaker": "N",
      "character_id": "narrator",
      "text": "Alguém sabe como mudar de planeta antes de segunda-feira?",
      "start": 25.6483,
      "end": 28.5997,
      "word_count": 9
    }
  ],
